{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Miggo",
  "description": "Documentação da plataforma Miggo — marketing de conteúdo no piloto automático.",
  "colors": {
    "primary": "#2a96a4",
    "light": "#4dccda",
    "dark": "#174c54"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Comece por aqui",
        "pages": [
          "index",
          "quickstart",
          "onboarding",
          "visao-geral"
        ]
      },
      {
        "group": "Sua marca",
        "pages": [
          "marca/minha-marca",
          "marca/estilo-visual"
        ]
      },
      {
        "group": "Conteúdo",
        "pages": [
          "conteudo/meus-conteudos",
          "conteudo/aprovacao",
          "conteudo/calendario-editorial",
          "conteudo/ideias-de-post",
          "conteudo/minhas-fotos"
        ]
      },
      {
        "group": "Redes sociais",
        "pages": [
          "redes/conectar",
          "redes/publicacao"
        ]
      },
      {
        "group": "Conta e plano",
        "pages": [
          "conta/meu-plano",
          "conta/perfil-e-acesso",
          "conta/notificacoes"
        ]
      },
      {
        "group": "Ajuda",
        "pages": [
          "ajuda/suporte",
          "ajuda/perguntas-frequentes",
          "ajuda/solucao-de-problemas"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Acessar a plataforma",
          "href": "https://app.miggomkt.com.br",
          "icon": "arrow-right-to-bracket"
        },
        {
          "anchor": "Falar com o suporte",
          "href": "mailto:oie@miggomkt.com.br",
          "icon": "life-ring"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:oie@miggomkt.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Entrar na plataforma",
      "href": "https://app.miggomkt.com.br/signin"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "website": "https://miggomkt.com.br"
    }
  }
}
